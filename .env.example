# OpenAI (ProxyAPI)
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_DELAY_SEC=1.0

# RAG paths
RAG_DOCS_PATH=rag_docs
CHROMA_PERSIST_PATH=data/chroma
CHROMA_COLLECTION_NAME=nevatom_kb_v1

# Chunking (token counts)
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=120
CHUNK_BATCH_SIZE=32

# Retrieval
RETRIEVAL_TOP_K=5
SIMILARITY_SCORE_THRESHOLD=0.35
MAX_CONTEXT_TOKENS=4000
INTENT_CACHE_TTL_SEC=300
INTENT_USE_LLM=false

# Cache
LRU_CACHE_MAXSIZE=256
DISK_CACHE_PATH=data/diskcache
DISK_CACHE_TTL_FAQ_HOURS=24
DISK_CACHE_TTL_TECHNICAL_HOURS=4

# Analytics DB (retrieval metadata)
ANALYTICS_DB_PATH=data/analytics.db

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# База данных (SQLite-файл, ставить ничего не нужно)
DATABASE_URL=sqlite+aiosqlite:///data/app.db

# Search
SEARCH_PAGE_SIZE=20
SEARCH_MAX_RESULTS=500
SEARCH_USE_LIVE_SOURCES=true
SEARCH_HTTP_TIMEOUT_SEC=30
SEARCH_REQUEST_DELAY_SEC=1.0
ZAKUPKI_API_BASE_URL=https://zakupki.gov.ru
ZAKUPKI_RSS_PATH=/epz/order/extendedsearch/rss.html
ZAKUPKI_OPEN_API_URL=your-api-url
ZAKUPKI_OPEN_API_KEY=your-api-key
FNS_EGRUL_BASE_URL=https://egrul.nalog.ru
REGISTRY_ABOK_URL=https://abok.ru
DGIS_BASE_URL=https://catalog.api.2gis.com
DGIS_API_KEY=your-api-key
DADATA_BASE_URL=https://suggestions.dadata.ru/suggestions-api
DADATA_API_KEY=your-api-key
DADATA_SECRET_KEY=your-secret-key

# Scoring weights
SCORE_OKVED_MATCH=20
SCORE_TENDERS_12M=15
SCORE_ACTIVE_WEBSITE=10
SCORE_REVENUE_50M=10
SCORE_REVENUE_200M=5
SCORE_SRO=10
SCORE_VENTILATION_MENTION=10
SCORE_LPR_MISSING_PENALTY=10
SCORE_NO_VENT_PENALTY=7
SCORE_COMPANY_AGE_2Y=5
SCORE_REGION_MATCH=15

# Analytics
ANALYTICS_BATCH_MAX=5
ANALYTICS_QUESTIONS_COUNT=10

# Chat widget
CHAT_SESSION_TTL_SEC=1800
CHAT_MAX_QUERY_LENGTH=500
CHAT_FALLBACK_SCORE_THRESHOLD=0.5
CHAT_RATE_LIMIT_PER_DAY=200
CHAT_STREAM_ENABLED=true
ROP_CONTACT_EMAIL=rop@example.com
